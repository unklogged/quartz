FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        rsync \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["bash", "-c", "\
set -e; \
\
echo 'Installing dependencies...'; \
npm ci --no-audit; \
\
if [ ! -d /obsidian ]; then \
    echo 'ERROR: /obsidian is not mounted'; \
    exit 1; \
fi; \
\
if [ -z \"$(ls -A /obsidian 2>/dev/null)\" ]; then \
    echo 'ERROR: /obsidian is empty; refusing to sync'; \
    exit 1; \
fi; \
\
echo 'Syncing Obsidian -> Quartz content...'; \
mkdir -p /workspace/content; \
rsync -a --delete /obsidian/ /workspace/content/; \
\
echo 'Ready.'; \
exec bash \
"]
